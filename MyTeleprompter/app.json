{
  "expo": {
    "name": "Nectra Teleprompter",
    "slug": "nectra-teleprompter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nectrateleprompter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nectradigital.teleprompter"
    },
    "android": {
      "package": "com.nectradigital.teleprompter",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Nectra.png",
        "backgroundImage": "./assets/images/Nectra.png",
        "monochromeImage": "./assets/images/Nectra.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Nectra.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Nectra.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    },
    "extra": {
      "router": {},
      "teleprompterApiUrl": "https://teleprompter.nectradigital.com/api?action=read",
      "eas": {
        "projectId": "17aa8ac2-f0b7-437f-b2ec-a2b5d159447d"
      }
    }
  }
}
